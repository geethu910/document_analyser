GROQ_API_KEY=            # API key for Groq
LLM_MODEL=llama-3.3-70b-versatile   # Default LLM model
EMBED_MODEL=all-MiniLM-L6-v2        # Embedding model
SMTP_PASSWORD=            # SMTP password
SMTP_HOST=                # SMTP host
SMTP_USER=                # SMTP username
EMAIL_FROM=               # Sender email address
DB_NAME=                  # Database name
DB_USER=                  # Database user
DB_PASSWORD=              # Database password
REDIS_URL=                # Redis connection URL
SECRET_KEY=               # App secret key
GCS_BUCKET_NAME=          # GCS bucket used to hand uploads off between the API and the Celery worker
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # Cross-encoder model
APP_BASE_URL=             # Base URL of the app
